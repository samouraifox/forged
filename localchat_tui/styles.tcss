Screen {
    background: #050706;
    color: #c8f5d4;
}

#layout {
    width: 100%;
    height: 100%;
    background: #050706;
}

#layout.session-idle {
    padding: 0 2 1 2;
    align: center middle;
}

#layout.session-active {
    padding: 1 2 0 2;
    align: center top;
}

#shell {
    width: 100%;
    min-width: 58;
}

#shell.session-idle {
    max-width: 86;
    height: auto;
}

#shell.session-active {
    max-width: 120;
    height: 100%;
}

AppHeader {
    height: auto;
}

#shell.session-idle AppHeader {
    margin-bottom: 1;
}

#shell.session-active AppHeader {
    margin-bottom: 0;
}

#ascii-logo {
    width: 100%;
    height: auto;
    content-align: center top;
    text-align: center;
    color: #39ff14;
    text-style: bold;
}

#logo-divider {
    width: 100%;
    height: 1;
    margin-top: 1;
    text-align: center;
    color: #7a1f60;
}

#app-title {
    width: 100%;
    text-align: center;
    color: #39ff14;
    text-style: bold;
}

#shell.session-idle #app-title {
    display: none;
}

#shell.session-active #app-title {
    display: block;
    margin-bottom: 0;
}

#app-subtitle {
    width: 100%;
    margin-top: 1;
    text-align: center;
    color: #ff39c6;
    text-style: italic;
}

#shell.session-active #app-subtitle {
    display: none;
}

#backend-line {
    width: 100%;
    margin-top: 1;
    text-align: center;
    color: #39c6ff;
}

#shell.session-active #backend-line {
    display: none;
}

#landing-status {
    width: 100%;
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
    text-align: center;
    color: #5a8060;
    text-style: italic;
}

ModeBar {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#shell.session-idle ModeBar {
    margin-bottom: 2;
}

#mode-row {
    width: 100%;
    height: auto;
    align: center middle;
}

#mode-cluster {
    width: auto;
    height: auto;
}

.mode-pill {
    width: 14;
    height: 3;
    margin: 0 1 0 0;
    padding: 0 1;
    background: #0a0e0a;
    color: #5a8060;
    border: round #1a2a1f;
    text-style: bold;
}

.mode-pill.is-on {
    background: #0d1410;
    color: #39ff14;
    border: round #ff39c6;
    text-style: bold;
}

.mode-pill.is-off {
    background: #0a0e0a;
    color: #6a8a70;
    border: round #2a3a30;
}

.mode-pill:focus {
    border: round #39c6ff;
    color: #c8f5d4;
}

#topk-shell {
    width: 16;
    height: 3;
    padding: 0 0 0 1;
    background: #0a0e0a;
    border: round #2a3a30;
    align: left middle;
}

#topk-label {
    width: 6;
    height: 1;
    color: #39c6ff;
    text-style: bold;
    content-align: left middle;
}

#topk-input {
    width: 6;
    height: 1;
    background: #0d1410;
    color: #39ff14;
    border: none;
    text-style: bold;
    padding: 0;
}

#topk-input:focus {
    background: #112019;
    color: #c8f5d4;
}

#conversation {
    height: 1fr;
    padding: 0 1;
    background: transparent;
    border: none;
    scrollbar-background: #050706;
    scrollbar-background-hover: #0a0e0a;
    scrollbar-color: #1a2a1f;
    scrollbar-color-active: #ff39c6;
    scrollbar-color-hover: #2a4a30;
}

#retrieve-indicator {
    width: 100%;
    height: 1;
    padding: 0 2;
    background: transparent;
    color: #39c6ff;
    text-style: bold;
    text-align: left;
    display: none;
}

#retrieve-indicator.is-active {
    display: block;
}

#transcript-column {
    width: 100%;
    height: auto;
}

#composer-divider {
    width: 100%;
    height: 1;
    margin-top: 1;
    background: transparent;
    color: #1a2a1f;
}

MessageBlock {
    width: 100%;
    height: auto;
    padding: 0 0 1 0;
    align-horizontal: left;
}

MessageBlock.kind-user {
    align-horizontal: left;
}

MessageBlock.kind-status,
MessageBlock.kind-system {
    align-horizontal: center;
}

.message-card {
    width: 100%;
    height: auto;
    padding: 0;
    background: transparent;
    border: none;
}

.kind-user .message-card {
    width: 100%;
    padding: 0 0 0 2;
    background: transparent;
    border-left: tall #39c6ff;
}

.kind-assistant .message-card {
    padding: 0 0 1 0;
    border-left: tall #39ff14;
    padding-left: 2;
}

.kind-thinking .message-card {
    padding: 0 1;
    border-left: tall #7a1f60;
    padding-left: 2;
}

.kind-tool .message-card {
    padding: 1 2;
    background: #0d0f08;
    border: round #ffaa00;
}

.kind-error .message-card {
    padding: 1 2;
    background: #1a0808;
    border: round #ff3939;
}

.kind-status .message-card,
.kind-system .message-card {
    width: auto;
    max-width: 92;
    padding: 0 1;
}

.message-label {
    width: 100%;
    margin-bottom: 1;
    color: #5a8060;
    text-style: bold;
}

.kind-user .message-label {
    color: #39c6ff;
}

.kind-assistant .message-label {
    color: #39ff14;
}

.kind-thinking .message-label {
    color: #ff39c6;
}

.kind-tool .message-label {
    color: #ffaa00;
}

.kind-error .message-label {
    color: #ff3939;
}

.message-body {
    width: 100%;
    color: #c8f5d4;
    text-wrap: wrap;
}

.kind-user .message-body {
    color: #c8e6ff;
}

.kind-assistant .message-body {
    color: #c8f5d4;
}

.kind-thinking .message-body {
    color: #7090a0;
    text-style: italic;
}

.kind-status .message-body {
    color: #5a8060;
    text-align: center;
    text-style: italic;
}

.kind-system .message-body {
    color: #39c6ff;
    text-align: center;
}

.kind-tool .message-body {
    color: #d8c08a;
}

.kind-error .message-body {
    color: #ffb8b8;
}

ChatComposer {
    height: auto;
    margin-top: 0;
}

#composer-shell {
    height: auto;
    padding: 0 1 1 1;
    background: #0a0e0a;
    border: round #1a2a1f;
}

ChatComposer.is-busy #composer-shell {
    border: round #ff39c6;
}

ChatComposer:focus-within #composer-shell {
    border: round #39ff14;
}

#composer-label {
    width: 100%;
    padding: 1 1 0 1;
    color: #39c6ff;
    text-style: bold;
}

ChatComposer.is-busy #composer-label {
    color: #ff39c6;
}

ComposerInput {
    height: 5;
    min-height: 4;
    max-height: 8;
    background: transparent;
    color: #c8f5d4;
    border: none;
    padding: 0 1;
}

ComposerInput:focus {
    background: #0d1410;
}

StatusBar {
    width: 100%;
    height: 3;
    margin-top: 1;
    padding: 0 1;
    background: #0a0e0a;
    border-top: tall #1a2a1f;
}

#status-line-1 {
    width: 100%;
    height: 1;
    color: #39ff14;
    text-style: bold;
}

#status-line-2 {
    width: 100%;
    height: 1;
    color: #5a8060;
}

#footer-hints {
    width: 100%;
    margin-top: 0;
    text-align: center;
    color: #3a5a40;
}
