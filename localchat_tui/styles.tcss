Screen {
    background: #18181b;
    color: #fafaf9;
}

#layout {
    width: 100%;
    height: 100%;
    background: #18181b;
}

#layout.session-idle {
    padding: 0 2 1 2;
    align: center middle;
}

#layout.session-active {
    padding: 1 2 0 2;
    align: center top;
}

#shell {
    width: 100%;
    min-width: 58;
}

#shell.session-idle {
    max-width: 86;
    height: auto;
}

#shell.session-active {
    max-width: 120;
    height: 100%;
}

AppHeader {
    height: auto;
}

#shell.session-idle AppHeader {
    margin-bottom: 1;
}

#shell.session-active AppHeader {
    margin-bottom: 0;
}

#ascii-logo {
    width: 100%;
    height: auto;
    content-align: center top;
    text-align: center;
    color: #fafaf9;
    text-style: bold;
}

#logo-divider {
    width: 100%;
    height: 1;
    margin-top: 1;
    text-align: center;
    color: #3f3f46;
}

#app-title {
    width: 100%;
    text-align: center;
    color: #fafaf9;
    text-style: bold;
}

#shell.session-idle #app-title {
    display: none;
}

#shell.session-active #app-title {
    display: block;
    margin-bottom: 0;
}

#app-subtitle {
    width: 100%;
    margin-top: 1;
    text-align: center;
    color: #a8a29e;
}

#shell.session-active #app-subtitle {
    display: none;
}

#backend-line {
    width: 100%;
    margin-top: 1;
    text-align: center;
    color: #94a3b8;
}

#shell.session-active #backend-line {
    display: none;
}

#landing-status {
    width: 100%;
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
    text-align: center;
    color: #78716c;
    text-style: italic;
}

ModeBar {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#shell.session-idle ModeBar {
    margin-bottom: 2;
}

#mode-row {
    width: 100%;
    height: auto;
    align: center middle;
}

#mode-cluster {
    width: auto;
    height: auto;
}

.mode-pill {
    width: 14;
    height: 3;
    margin: 0 1 0 0;
    padding: 0 1;
    background: #1c1917;
    color: #a8a29e;
    border: round #3f3f46;
    text-style: bold;
}

.mode-pill.is-on {
    background: #1c1917;
    color: #fafaf9;
    border: round #d97706;
    text-style: bold;
}

.mode-pill.is-off {
    background: #1c1917;
    color: #78716c;
    border: round #3f3f46;
}

.mode-pill:focus {
    border: round #fbbf24;
    color: #fafaf9;
}

#topk-shell {
    width: 16;
    height: 3;
    padding: 0 0 0 1;
    background: #1c1917;
    border: round #3f3f46;
    align: left middle;
}

#topk-label {
    width: 6;
    height: 1;
    color: #94a3b8;
    text-style: bold;
    content-align: left middle;
}

#topk-input {
    width: 6;
    height: 1;
    background: #27272a;
    color: #fafaf9;
    border: none;
    text-style: bold;
    padding: 0;
}

#topk-input:focus {
    background: #292524;
    color: #fafaf9;
}

#conversation {
    height: 1fr;
    padding: 0 1;
    background: transparent;
    border: none;
    scrollbar-background: #18181b;
    scrollbar-background-hover: #1c1917;
    scrollbar-color: #3f3f46;
    scrollbar-color-active: #d97706;
    scrollbar-color-hover: #57534e;
}

#retrieve-indicator {
    width: 100%;
    height: 1;
    padding: 0 2;
    background: transparent;
    color: #d97706;
    text-style: bold;
    text-align: left;
    display: none;
}

#retrieve-indicator.is-active {
    display: block;
}

#transcript-column {
    width: 100%;
    height: auto;
}

#composer-divider {
    width: 100%;
    height: 1;
    margin-top: 1;
    background: transparent;
    color: #27272a;
}

MessageBlock {
    width: 100%;
    height: auto;
    padding: 0 0 1 0;
    align-horizontal: left;
}

MessageBlock.kind-user {
    align-horizontal: left;
}

MessageBlock.kind-status,
MessageBlock.kind-system {
    align-horizontal: center;
}

.message-card {
    width: 100%;
    height: auto;
    padding: 0;
    background: transparent;
    border: none;
}

.kind-user .message-card {
    width: 100%;
    padding: 0 0 0 2;
    background: transparent;
    border-left: tall #94a3b8;
}

.kind-assistant .message-card {
    padding: 0 0 1 0;
    border-left: tall #fafaf9;
    padding-left: 2;
}

.kind-thinking .message-card {
    padding: 0 1;
    border-left: tall #64748b;
    padding-left: 2;
}

.kind-tool .message-card {
    padding: 1 2;
    background: #1c1917;
    border: round #57534e;
}

.kind-error .message-card {
    padding: 1 2;
    background: #1f1313;
    border: round #dc2626;
}

.kind-status .message-card,
.kind-system .message-card {
    width: auto;
    max-width: 92;
    padding: 0 1;
}

.message-label {
    width: 100%;
    margin-bottom: 1;
    color: #a8a29e;
    text-style: bold;
}

.kind-user .message-label {
    color: #94a3b8;
}

.kind-assistant .message-label {
    color: #fafaf9;
}

.kind-thinking .message-label {
    color: #64748b;
}

.kind-tool .message-label {
    color: #d97706;
}

.kind-error .message-label {
    color: #dc2626;
}

.message-body {
    width: 100%;
    color: #fafaf9;
    text-wrap: wrap;
}

.kind-user .message-body {
    color: #e7e5e4;
}

.kind-assistant .message-body {
    color: #fafaf9;
}

.kind-thinking .message-body {
    color: #a8a29e;
    text-style: italic;
}

.kind-status .message-body {
    color: #78716c;
    text-align: center;
    text-style: italic;
}

.kind-system .message-body {
    color: #94a3b8;
    text-align: center;
}

.kind-tool .message-body {
    color: #d4d4d8;
}

.kind-error .message-body {
    color: #fca5a5;
}

ChatComposer {
    height: auto;
    margin-top: 0;
}

#composer-shell {
    height: auto;
    padding: 0 1 1 1;
    background: #1c1917;
    border: round #3f3f46;
}

ChatComposer.is-busy #composer-shell {
    border: round #92400e;
}

ChatComposer:focus-within #composer-shell {
    border: round #d97706;
}

#composer-label {
    width: 100%;
    padding: 1 1 0 1;
    color: #94a3b8;
    text-style: bold;
}

ChatComposer.is-busy #composer-label {
    color: #d97706;
}

ComposerInput {
    height: 5;
    min-height: 4;
    max-height: 8;
    background: transparent;
    color: #fafaf9;
    border: none;
    padding: 0 1;
}

ComposerInput:focus {
    background: #1c1917;
}

StatusBar {
    width: 100%;
    height: 3;
    margin-top: 1;
    padding: 0 1;
    background: #1c1917;
    border-top: tall #27272a;
}

#status-line-1 {
    width: 100%;
    height: 1;
    color: #fafaf9;
    text-style: bold;
}

#status-line-2 {
    width: 100%;
    height: 1;
    color: #a8a29e;
}

#footer-hints {
    width: 100%;
    margin-top: 0;
    text-align: center;
    color: #57534e;
}
